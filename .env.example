# ==============================================================================
# Angle Ideation Agent — Environment Variables & API Configuration
# ==============================================================================

# 1. LLM Provider API Keys (at least one is required for standalone execution)
# ------------------------------------------------------------------------------
# Google Gemini API Key (recommended: https://aistudio.google.com/)
GEMINI_API_KEY=

# OpenAI API Key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Anthropic Claude API Key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# 2. Default Provider & Model Selection
# ------------------------------------------------------------------------------
# Provider: 'gemini', 'openai', or 'anthropic'
LLM_PROVIDER=gemini

# Model name:
# - Gemini: 'gemini-1.5-pro', 'gemini-2.5-flash', 'gemini-2.5-pro'
# - OpenAI: 'gpt-4o', 'gpt-4o-mini', 'o3-mini'
# - Anthropic: 'claude-3-5-sonnet-20241022', 'claude-3-5-haiku-20241022'
LLM_MODEL=gemini-1.5-pro

# 3. Execution Parameters & Style Controls
# ------------------------------------------------------------------------------
# Temperature: 0.0 to 1.0 (default 0.7 for creative ideation)
LLM_TEMPERATURE=0.7

# Style Controls:
# - Intensity (1-5): 1 = subtle curiosity, 5 = high-resonance urgency
# - Darkness (0-1): 0 = standard everyday friction, 1 = acute friction
# - Formality (1-5): 1 = colloquial/conversational, 5 = technical/analytical
# - Distance (1-5): 1 = 1st person narrative, 5 = 3rd person observational
STYLE_INTENSITY=4
STYLE_DARKNESS=0
STYLE_FORMALITY=2
STYLE_DISTANCE=1
