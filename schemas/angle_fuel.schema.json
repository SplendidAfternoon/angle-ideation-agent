{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.angle-ideation-agent/schemas/angle_fuel.schema.json",
  "title": "AngleFuel",
  "type": "object",
  "required": [
    "meta",
    "avatar",
    "pain_points",
    "failed_attempts",
    "emotional_effects",
    "exact_vocabulary",
    "future_fears",
    "product_fit",
    "competitors",
    "psychosocial_currencies_candidates",
    "beliefs",
    "gaps"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["scenario", "methodology", "product_name"],
      "properties": {
        "scenario": { "enum": ["A", "B"] },
        "methodology": { "type": "string" },
        "product_name": { "type": "string" },
        "source_refs": { "type": "array", "items": { "type": "string" } },
        "style_controls": {
          "type": "object",
          "properties": {
            "intensity": { "type": "integer", "minimum": 1, "maximum": 5 },
            "darkness": { "type": "integer", "minimum": 0, "maximum": 1 },
            "formality": { "type": "integer", "minimum": 1, "maximum": 5 },
            "distance": { "type": "integer", "minimum": 1, "maximum": 5 }
          },
          "additionalProperties": false
        },
        "telemetry": {
          "type": "object",
          "properties": {
            "trace_id": { "type": "string" },
            "model_version": { "type": "string" },
            "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
            "tokens_in": { "type": "integer" },
            "tokens_out": { "type": "integer" }
          },
          "additionalProperties": false
        }
      }
    },
    "avatar": {
      "type": "object",
      "required": ["name", "description"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 20 },
        "awareness_notes": { "type": "string" },
        "labels": { "type": "object" }
      }
    },
    "pain_points": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["cluster", "description", "examples"],
        "properties": {
          "cluster": { "type": "string" },
          "description": { "type": "string" },
          "examples": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "label": {
            "enum": [
              "EVIDENCED",
              "DERIVED",
              "PLAUSIBLE_INFERENCE",
              "UNKNOWN"
            ]
          }
        }
      }
    },
    "failed_attempts": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["attempt", "why_it_failed"],
        "properties": {
          "attempt": { "type": "string" },
          "why_it_failed": { "type": "string" },
          "label": {
            "enum": [
              "EVIDENCED",
              "DERIVED",
              "PLAUSIBLE_INFERENCE",
              "UNKNOWN"
            ]
          }
        }
      }
    },
    "emotional_effects": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "string" }
    },
    "exact_vocabulary": {
      "type": "array",
      "minItems": 5,
      "items": { "type": "string", "minLength": 3 }
    },
    "future_fears": {
      "type": "array",
      "items": { "type": "string" }
    },
    "product_fit": {
      "type": "object",
      "required": ["mechanism", "how_it_resolves"],
      "properties": {
        "mechanism": { "type": "string", "minLength": 10 },
        "how_it_resolves": { "type": "string", "minLength": 10 },
        "label": {
          "enum": [
            "EVIDENCED",
            "DERIVED",
            "PLAUSIBLE_INFERENCE",
            "UNKNOWN"
          ]
        }
      }
    },
    "competitors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "loved": { "type": "string" },
          "hated": { "type": "string" },
          "label": {
            "enum": [
              "EVIDENCED",
              "DERIVED",
              "PLAUSIBLE_INFERENCE",
              "UNKNOWN"
            ]
          }
        }
      }
    },
    "psychosocial_currencies_candidates": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": ["currency_id", "why_it_applies"],
        "properties": {
          "currency_id": { "type": "string" },
          "why_it_applies": { "type": "string" },
          "evidence_refs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "label": {
            "enum": [
              "EVIDENCED",
              "DERIVED",
              "PLAUSIBLE_INFERENCE",
              "UNKNOWN"
            ]
          }
        }
      }
    },
    "beliefs": {
      "type": "object",
      "required": ["held", "ready_to_shift"],
      "properties": {
        "held": { "type": "array", "items": { "type": "string" } },
        "ready_to_shift": {
          "type": "array",
          "items": { "type": "string" }
        },
        "label": {
          "enum": [
            "EVIDENCED",
            "DERIVED",
            "PLAUSIBLE_INFERENCE",
            "UNKNOWN"
          ]
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field", "status"],
        "properties": {
          "field": { "type": "string" },
          "status": { "enum": ["UNKNOWN"] },
          "impact": { "type": "string" }
        }
      }
    }
  },
  "additionalProperties": false
}

