{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.angle-ideation-agent/schemas/angle_pack.schema.json",
  "title": "AnglePack",
  "description": "Machine mirror of docs/01 Emotional Angle Pack. Markdown remains the human handoff.",
  "type": "object",
  "required": ["pack"],
  "properties": {
    "pack": {
      "type": "object",
      "required": [
        "product_name",
        "version",
        "date",
        "methodology",
        "status",
        "scenario",
        "run_id",
        "angles"
      ],
      "properties": {
        "product_name": { "type": "string", "minLength": 1 },
        "version": { "type": "string" },
        "style_controls": {
          "type": "object",
          "properties": {
            "intensity": { "type": "integer", "minimum": 1, "maximum": 5 },
            "darkness": { "type": "integer", "minimum": 0, "maximum": 1 },
            "formality": { "type": "integer", "minimum": 1, "maximum": 5 },
            "distance": { "type": "integer", "minimum": 1, "maximum": 5 }
          },
          "additionalProperties": false
        },
        "telemetry": {
          "type": "object",
          "properties": {
            "trace_id": { "type": "string" },
            "model_version": { "type": "string" },
            "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
            "tokens_in": { "type": "integer" },
            "tokens_out": { "type": "integer" }
          },
          "additionalProperties": false
        },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "methodology": { "type": "string", "pattern": "^angle-ideation-agent@" },
        "status": {
          "enum": ["Ready for Pre-Lander Agent", "Blocked"]
        },
        "scenario": { "enum": ["A", "B"] },
        "run_id": { "type": "string", "minLength": 1 },
        "contains": { "type": "integer", "minimum": 1, "maximum": 8 },
        "angles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": [
              "ordinal",
              "name",
              "currency_id",
              "core_idea",
              "headline",
              "hollow",
              "villain",
              "dream",
              "story_arc",
              "product_fit"
            ],
            "properties": {
              "ordinal": { "type": "integer", "minimum": 1 },
              "name": { "type": "string", "minLength": 1 },
              "currency_id": {
                "enum": [
                  "RELATIONAL_EQUITY",
                  "IDENTITY_SELFHOOD",
                  "SAFETY_SECURITY",
                  "TRUST_SAFETY",
                  "SOCIAL_STATUS",
                  "AGENCY_CONTROL",
                  "GUILT_REGRET",
                  "BODILY_AUTONOMY",
                  "GENTLENESS",
                  "AUTHORITY",
                  "FUTURE_SECURITY",
                  "AGENCY_PARTNERSHIP"
                ]
              },
              "core_idea": { "type": "string", "minLength": 10 },
              "headline": { "type": "string", "minLength": 3 },
              "hollow": { "type": "string", "minLength": 20 },
              "villain": { "type": "string", "minLength": 10 },
              "dream": { "type": "string", "minLength": 10 },
              "story_arc": { "type": "string", "minLength": 20 },
              "product_fit": { "type": "string", "minLength": 10 },
              "awareness_stage": {
                "enum": ["problem_aware", "solution_aware", "product_aware"]
              },
              "test_priority": { "type": "integer", "minimum": 1, "maximum": 8 },
              "variants": {
                "type": "object",
                "properties": {
                  "compressed_story": { "type": "string", "minLength": 20 },
                  "hook_cluster": {
                    "type": "array",
                    "items": { "type": "string", "minLength": 3 }
                  },
                  "objection_flip": { "type": "string" }
                },
                "additionalProperties": false
              }
            }
          }
        }
      }
    }
  }
}
