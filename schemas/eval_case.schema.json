{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.angle-ideation-agent/schemas/eval_case.schema.json",
  "title": "EvalCaseManifest",
  "description": "Expected labels for eval/harness.py",
  "type": "object",
  "required": ["version", "cases"],
  "properties": {
    "version": { "type": "string" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "run_dir", "expect", "kind"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "run_dir": { "type": "string", "minLength": 1 },
          "product": { "type": "string" },
          "expect": { "enum": ["PASS", "FAIL"] },
          "kind": {
            "enum": [
              "live_run",
              "negative_control",
              "ops_stub",
              "transfer_run",
              "vsl_doctrine"
            ]
          },
          "must_flag": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
